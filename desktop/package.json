{
  "name": "dafeiyu-music-hub-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "大肥鱼音乐管家 · 桌面壳",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.dafeiyu.musichub",
    "productName": "大肥鱼音乐管家",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DafeiyuMusicHub-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "大肥鱼音乐管家"
    }
  }
}
